# ==============================================================================
# MenuMint SaaS — Environment Configuration Template
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Authentication secret (required in production)
JWT_SECRET=replace-with-a-secure-random-secret-in-production

# Application URLs (distinguish merchant app from payment gateway)
APP_URL=http://localhost:3000
# VITE_API_BASE_URL: Leave empty in dev for same-origin Vite proxy
VITE_API_BASE_URL=

# ==============================================================================
# YouPI-PG V2 Decentralized Payment Gateway Configuration
# ==============================================================================
# The gateway is a separately deployed service dependency. For local development,
# run `npm run dev` in the youpi-pg repository (starts API on 6100, Checkout on 7000).
# In production, replace localhost URLs with your secure HTTPS endpoints.

# 1. Gateway REST API base URL (Backend-to-Backend session creation & health)
YOUPI_API_URL=http://localhost:6100

# 2. Customer Hosted Checkout Portal URL (Frontend redirection / QR rendering)
YOUPI_CHECKOUT_URL=http://localhost:7000

# 3. Merchant UUID (Obtain from Merchant Admin at http://localhost:6001 or DB)
YOUPI_MERCHANT_ID=merch_menumint_001

# 4. Webhook Signing Secret (Used for HMAC-SHA256 signature verification)
# Must match the webhook secret configured in YouPI Merchant Admin / receiving account
YOUPI_WEBHOOK_SECRET=youpi_sec_live_grind789

# 5. Merchant Receiving UPI ID (Used to construct standardized NPCI UPI Intent QR)
YOUPI_UPI_ID=dailygrind@upi

# 6. Display Payee Name for UPI Apps
YOUPI_PAYEE_NAME=The Daily Grind Cafe

# 7. Currency for UPI settlement (Indian Rupee minor units paise)
YOUPI_CURRENCY=INR
